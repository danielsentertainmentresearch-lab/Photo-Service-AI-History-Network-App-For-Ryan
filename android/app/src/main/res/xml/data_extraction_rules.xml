<?xml version="1.0" encoding="utf-8"?>
<!-- Excludes app data from cloud backup and device-to-device transfer: the
     encrypted API key cannot be restored on another device, and the photo vault
     is meant to stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
